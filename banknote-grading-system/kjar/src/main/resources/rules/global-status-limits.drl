// Pravilo 8
rule "Grade Limit - MAX_VERY_GOOD (Moderate Damage)"
    salience 2
    agenda-group "global-status-limits"
    when
        $fc: FactConclusion(integrity == DerivedStatus.Integrity.MODERATE_DAMAGE)
    then
        modify($fc) { setGradeLimit(DerivedStatus.GradeLimit.MAX_VERY_GOOD) };
        insert(new Defect($fc.getBanknoteId(), "gradeLimit", "MAX_VERY_GOOD",
                    "Moderate damage is present: edges have tiny nicks, minor tears extend into the main design, or a center hole is visible from excessive folding. Grade is capped at VERY_GOOD."));
end

// Pravilo 9
rule "Grade Limit - MAX_VERY_GOOD (Rounded Corners)"
    agenda-group "global-status-limits"
    salience 2
    when
        $b: Banknote($id: id, corners == InputFeatures.Corners.ROUNDED_OR_MISSING)
        $fc: FactConclusion(banknoteId == $id)
    then
        modify($fc) { setGradeLimit(DerivedStatus.GradeLimit.MAX_VERY_GOOD) };
        insert(new Defect($id, "gradeLimit", "MAX_VERY_GOOD",
                    "Corners show heavy wear, rounding, or missing corner pieces. This full rounding acts as a barrier preventing a higher circulated grade classification."));
end

// Pravilo 10
rule "Grade Limit - MAX_FAIR (Severe Damage)"
    agenda-group "global-status-limits"
    salience 1
    when
        $fc: FactConclusion(integrity == DerivedStatus.Integrity.SEVERE_DAMAGE)
    then
        modify($fc) { setGradeLimit(DerivedStatus.GradeLimit.MAX_FAIR) };
        insert(new Defect($fc.getBanknoteId(), "gradeLimit", "MAX_FAIR",
                "Severe physical defects detected: larger pieces may be half torn off or missing, and tears are significantly larger, limiting the grade to FAIR."));
end

// Pravilo 11
rule "Grade Limit - MAX_FAIR (Damaged Paper)"
    agenda-group "global-status-limits"
    salience 1
    when
        $b: Banknote($id: id, wear == InputFeatures.Wear.DAMAGED_PAPER)
        $fc: FactConclusion(banknoteId == $id)
    then
        modify($fc) { setGradeLimit(DerivedStatus.GradeLimit.MAX_FAIR) };
        insert(new Defect($id, "gradeLimit", "MAX_FAIR",
                    "The underlying substrate suffers from severe wear ('Damaged Paper'), which restricts the absolute maximum grade to FAIR."));
end

// Pravilo 12
rule "Grade Limit - MAX_VERY_FINE (Foil Broken Surface)"
    agenda-group "global-status-limits"
    salience 3
    when
        $b: Banknote($id: id, foilFeatures == InputFeatures.FoilFeatures.DAMAGED_FOLDS_BROKEN_SURFACE)
        $fc: FactConclusion(banknoteId == $id, gradeLimit == null)
    then
        modify($fc) { setGradeLimit(DerivedStatus.GradeLimit.MAX_VERY_FINE) };
        insert(new Defect($id, "gradeLimit", "MAX_VERY_FINE",
                "The holographic/security foil is broken along the fold lines, which enforces a mandatory limit, capping the note at a maximum of VERY_FINE."));
end

// Pravilo 13
rule "Grade Limit - MAX_VERY_FINE (Foil Significantly Damaged)"
    agenda-group "global-status-limits"
    salience 3
    when
        $b: Banknote($id: id, foilFeatures == InputFeatures.FoilFeatures.SIGNIFICANTLY_DAMAGED)
        $fc: FactConclusion(banknoteId == $id)
    then
        modify($fc) { setGradeLimit(DerivedStatus.GradeLimit.MAX_VERY_FINE) };
        insert(new Defect($id, "gradeLimit", "MAX_VERY_FINE",
                    "Significant damage or heavy abrasion on the security foil feature restricts the banknote from qualifying for premium uncirculated or high-grade thresholds."));
end