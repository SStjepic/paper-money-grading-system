package rules;

import com.sbnz.model.models.Banknote;
import com.sbnz.model.models.FactConclusion;
import com.sbnz.model.enums.InputFeatures;

import com.sbnz.model.enums.DerivedStatus;

// Pravilo 1
rule "Paper Status - PREMIUM"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, paper == InputFeatures.Paper.FIRM, sheen == InputFeatures.Sheen.ORIGINAL_SHEEN)
        $fc: FactConclusion(banknoteId == $id, paperStatus == null)
    then
        modify($fc) { setPaperStatus(DerivedStatus.PaperStatus.PREMIUM) };
end

// Pravilo 2
rule "Paper Status - STRONG"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, paper == InputFeatures.Paper.CRISP, sheen == InputFeatures.Sheen.LOST_SHEEN)
        $fc: FactConclusion(banknoteId == $id, paperStatus == null)
    then
        modify($fc) { setPaperStatus(DerivedStatus.PaperStatus.STRONG) };
end

// Pravilo 3
rule "Paper Status - SOFTENED"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, paper == InputFeatures.Paper.SOME_SOFTNESS_WRINKLED)
        $fc: FactConclusion(banknoteId == $id, paperStatus == null)
    then
        modify($fc) { setPaperStatus(DerivedStatus.PaperStatus.SOFTENED) };
end

// Pravilo 4
rule "Paper Status - DEGRADED (Limp)"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, paper == InputFeatures.Paper.LIMP)
        $fc: FactConclusion(banknoteId == $id, paperStatus == null)
    then
        modify($fc) { setPaperStatus(DerivedStatus.PaperStatus.DEGRADED) };
end

// Pravilo 5
rule "Paper Status - DEGRADED (Totally Limp)"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, paper == InputFeatures.Paper.TOTALLY_LIMP)
        $fc: FactConclusion(banknoteId == $id, paperStatus == null)
    then
        modify($fc) { setPaperStatus(DerivedStatus.PaperStatus.DEGRADED) };
end

// Pravilo 6
rule "Folding Level - NO_FOLDS"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, folds == InputFeatures.Folds.NO_FOLDS, creases == InputFeatures.Creases.NO_CREASES, wrinkles == InputFeatures.Wrinkles.NO_WRINKLES)
        $fc: FactConclusion(banknoteId == $id, foldingLevel == null)
    then
        modify($fc) { setFoldingLevel(DerivedStatus.FoldingLevel.NO_FOLDS) };
end

// Pravilo 7
rule "Folding Level - MINIMAL_FOLDS (1 light fold)"
