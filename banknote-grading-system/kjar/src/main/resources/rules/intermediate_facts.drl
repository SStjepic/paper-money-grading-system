    when
        $b: Banknote($id: id, folds == InputFeatures.Folds.ONE_LIGHT_FOLD)
        $fc: FactConclusion(banknoteId == $id, foldingLevel == null)
    then
        modify($fc) { setFoldingLevel(DerivedStatus.FoldingLevel.MINIMAL_FOLDS) };
end

