// Pravilo 34
rule "Physical Wear - LOW"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, corners == InputFeatures.Corners.SHARP_AND_SQUARE, wear == InputFeatures.Wear.NO_WEAR)
        $fc: FactConclusion(banknoteId == $id, physicalWear == null)
    then
        modify($fc) { setPhysicalWear(DerivedStatus.PhysicalWear.LOW) };
end

// Pravilo 35
rule "Physical Wear - MEDIUM"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, corners == InputFeatures.Corners.WORN_BUT_NOT_ROUNDED, wear == InputFeatures.Wear.SHOWS_WEAR)
        $fc: FactConclusion(banknoteId == $id, physicalWear == null)
    then
        modify($fc) { setPhysicalWear(DerivedStatus.PhysicalWear.MEDIUM) };
end

// Pravilo 36
rule "Physical Wear - HIGH (Corners)"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, corners == InputFeatures.Corners.ROUNDED_OR_MISSING)
        $fc: FactConclusion(banknoteId == $id, physicalWear == null)
    then
        modify($fc) { setPhysicalWear(DerivedStatus.PhysicalWear.HIGH) };
end

// Pravilo 37
rule "Physical Wear - HIGH (Paper)"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, wear == InputFeatures.Wear.DAMAGED_PAPER)
        $fc: FactConclusion(banknoteId == $id, physicalWear == null)
    then
        modify($fc) { setPhysicalWear(DerivedStatus.PhysicalWear.HIGH) };
end