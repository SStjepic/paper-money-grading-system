// Pravilo 27
rule "Cleanliness - IMMACULATE"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, dirt == InputFeatures.Dirt.NO_DIRT, stains == InputFeatures.Stains.NO_STAINS, graffiti == InputFeatures.Graffiti.NO_GRAFFITI, rust == InputFeatures.Rust.NO_RUST)
        $fc: FactConclusion(banknoteId == $id, cleanliness == null)
    then
        modify($fc) { setCleanliness(DerivedStatus.Cleanliness.IMMACULATE) };
end

// Pravilo 28
rule "Cleanliness - LIGHTLY_SOILED (Minimal dirt)"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, dirt == InputFeatures.Dirt.MINIMAL)
        $fc: FactConclusion(banknoteId == $id, cleanliness == null)
    then
        modify($fc) { setCleanliness(DerivedStatus.Cleanliness.LIGHTLY_SOILED) };
end

