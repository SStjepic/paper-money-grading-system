// Pravilo 15
rule "Integrity - INTACT"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, tears == InputFeatures.Tears.NO_TEARS, holes == InputFeatures.Holes.NO_HOLES, piecesMissing == InputFeatures.PiecesMissing.NO_PIECES, staplePinHoles == InputFeatures.StaplePinHoles.NONE)
        $fc: FactConclusion(banknoteId == $id, integrity == null)
    then
        modify($fc) { setIntegrity(DerivedStatus.Integrity.INTACT) };
end

