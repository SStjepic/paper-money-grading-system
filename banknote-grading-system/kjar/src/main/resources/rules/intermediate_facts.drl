// Pravilo 33
rule "Cleanliness - CONTAMINATED (Rust)"
    agenda-group "intermediate-facts"
    when
        $b: Banknote($id: id, rust == InputFeatures.Rust.RUST_PRESENT)
        $fc: FactConclusion(banknoteId == $id, cleanliness == null)
    then
